# ===========================
# Backend Environment Variables
# ===========================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-tasks

# JWT Secrets (generate strong random strings for production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Email) — use Ethereal for dev: https://ethereal.email/
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
EMAIL_FROM=noreply@smarttasks.app

# AI — Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Frontend URL (for password reset links in emails)
FRONTEND_URL=http://localhost:5173
